From e2c9da10cf7fb29cb86b8d4fcb35d4dfde62293e Mon Sep 17 00:00:00 2001
From: Ada Example <ada@example.com>
Date: Wed, 21 Oct 2026 09:30:00 +0900
Subject: [PATCH 1/2] Count words with a Unicode pattern, not with spaces

Before: "Hello,  world" counted 3 words (two spaces make an empty word),
and an empty file counted 1. After: 2 and 0. The result shows in a
toast instead of a blocking alert().
---
 plugins/tool-word-count.js | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/plugins/tool-word-count.js b/plugins/tool-word-count.js
index 7bcf9c0..7c101a9 100644
--- a/plugins/tool-word-count.js
+++ b/plugins/tool-word-count.js
@@ -2,8 +2,12 @@
 (function () {
     'use strict';
 
+    // A word is a run of letters, digits, apostrophes or hyphens, in any script.
+    var WORD = /[\p{L}\p{N}'’-]+/gu;
+
     function countWords(text) {
-        return text.split(' ').length;
+        var matches = text.match(WORD);
+        return matches === null ? 0 : matches.length;
     }
 
     window.FamousPluginCore.Manager.register({
@@ -11,7 +15,7 @@
         extensions: ['md', 'txt'],
         action: function (editor) {
             var total = countWords(editor.getValue());
-            alert(total + ' words');
+            window.showToast(total + ' words', 'info');
         }
     });
 })();
-- 
2.43.0

