/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob: data:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'

# ffactory calls the GitHub API (own policy later, decision Q10 postponed)
/factory/*
  ! Content-Security-Policy

# Test pages use inline scripts and load the app in an iframe
/tests/*
  ! Content-Security-Policy
